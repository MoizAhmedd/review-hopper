{
  "manifest_version": 3,
  "name": "Review Hopper",
  "version": "1.0.0",
  "description": "Review GitLab merge requests and GitHub pull requests by what matters: summaries, rendered docs, tests out of the way.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Review Hopper",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://gitlab.com/*", "https://github.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
